{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sms",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "author": "Erivelton Silva <eriveltondasilva13@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eriveltondasilva13/school-management-system.git"
    },
    "license": "MIT",
    "scripts": {
        "build": "bunx --bun vite build",
        "build:ssr": "bunx --bun vite build && bunx --bun vite build --ssr",
        "dev": "bunx --bun vite",
        "fmt": "prettier --write resources/",
        "fmt:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "types": "tsc --noEmit",
        "fix": "bun run types && bun run fmt && bun run lint",
        "shadcn:list": "ls resources/js/components/ui | sed 's/.tsx//' | tr '\\n' ' '"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@types/bun": "^1.3.10",
        "@types/node": "24.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript-eslint": "^8.56.1"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.9",
        "@inertiajs/react": "^2.3.17",
        "@tailwindcss/vite": "^4.2.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.2.1",
        "globals": "^17.4.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^2.1.0",
        "lucide-react": "^0.575.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.2.1",
