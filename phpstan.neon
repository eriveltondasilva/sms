includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 5

    paths:
        - app
        - bootstrap/app.php
        - config
        - routes
        # - database

    excludePaths:
        - vendor
        - node_modules
        - storage
        - bootstrap/cache
        - tmp
        - public/build
        - _ide_helper.php
        - _ide_helper_models.php

    tmpDir: /tmp/phpstan
